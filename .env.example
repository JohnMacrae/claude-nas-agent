# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Postgres (property-docs-db, on the shared agent-net network).
# store.js uses this when set; falls back to local JSON under DATA_DIR if unset.
# Internal (container-to-container) port is 5432; host-published port is 5435.
DATABASE_URL=postgresql://propertydocs:change-me-please@property-docs-db:5432/property_docs

# Used by docs.js (embedding search queries). Optional — docs.js falls back
# to Postgres full-text/ILIKE search on document_chunks without it.
OPENROUTER_API_KEY=

# Pushover
PUSHOVER_TOKEN=
PUSHOVER_USER=

# Watchdog timing
WATCHDOG_POLL_MS=300000

# Telegram — dedicated property bot (not personal OBBot)
TELEGRAM_BOT_TOKEN=        # From @BotFather — Property Agent bot
TELEGRAM_CHAT_ID=          # From getUpdates after sending /start to the bot

# FreeAgent
FREEAGENT_CLIENT_ID=
FREEAGENT_CLIENT_SECRET=
FREEAGENT_REFRESH_TOKEN=
FREEAGENT_CONTACT_URL=     # Fallback contact when no property shortcode

# Alto property management API (credentials pending)
ALTO_DATAFEED_ID=
ALTO_USERNAME=
ALTO_PASSWORD=
