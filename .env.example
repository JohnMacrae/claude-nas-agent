# Postgres (property-docs-db on agent-net)
DATABASE_URL=postgresql://propertydocs:change-me-please@property-docs-db:5432/property_docs

# LLM — agent inference. Default is OpenRouter; Ollama on SHACK (Tailscale)
# is an in-progress alternate backend — set LLM_BACKEND=ollama to use it once
# shack is actually serving on OLLAMA_BASE_URL (port 11434 was unreachable
# as of 2026-08-25, see NEXT.md).
LLM_BACKEND=openrouter
OLLAMA_BASE_URL=http://shack.beetal-carp.ts.net:11434
AGENT_MODEL=google/gemini-2.5-flash

# OpenRouter — inference + optional embeddings (docs.js)
OPENROUTER_API_KEY=

# Voice / Siri Shortcuts → POST /command (header X-Command-Token)
COMMAND_TOKEN=

# Google Calendar (gcal.js) — OAuth refresh token with calendar scope
# Primary source is data/google-refresh-token (written by rentr-dashboard on
# /admin/google-auth). GOOGLE_REFRESH_TOKEN is a legacy env fallback only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Pushover
PUSHOVER_TOKEN=
PUSHOVER_USER=

# Watchdog timing
WATCHDOG_POLL_MS=300000

# Telegram — dedicated property bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# FreeAgent
FREEAGENT_CLIENT_ID=
FREEAGENT_CLIENT_SECRET=
FREEAGENT_REFRESH_TOKEN=
FREEAGENT_CONTACT_URL=

# Alto (credentials pending)
ALTO_DATAFEED_ID=
ALTO_USERNAME=
ALTO_PASSWORD=
